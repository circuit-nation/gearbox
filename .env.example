CN_MONGODB_URI=mongodb://localhost:27017/circuit-nation

# Tier Nation API base including /api/v1 (e.g. http://localhost:8080/api/v1). Public GET /lists and admin /admin/* are appended to this URL.
TIER_NATION_API_BASE_URL=http://localhost:8080/api/v1
TIER_NATION_ADMIN_USERNAME=
TIER_NATION_ADMIN_PASSWORD=

# Signed session cookie for this dashboard (min 16 chars)
ADMIN_SESSION_SECRET=

# Existing S3 / AWS (upload-url, get-image-url)
CN_AWS_S3_REGION=
CN_AWS_ACCESS_KEY=
CN_AWS_SECRET_KEY=
CN_S3_BUCKET=
